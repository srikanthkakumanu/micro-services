{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "reviews-service"
      },
      "spec": {
        "selector": {
          "app": "reviews-service"
        },
        "ports": [
          {
            "name": "http",
            "port": 9171,
            "targetPort": 9171
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "reviews-service"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "reviews-service"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "reviews-service"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "128Mi"
                }
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "reviews-service",
                "image": "reviews-service:latest",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "containerPort": 9171,
                    "name": "http"
                  }
                ],
                "env": [
                  {
                    "name": "SERVER_PORT",
                    "value": "9171"
                  },
                  {
                    "name": "SPRING_APP_NAME",
                    "value": "reviews-service"
                  },
                  {
                    "name": "SPRING_ACTIVE_PROFILE",
                    "value": "dev"
                  },
                  {
                    "name": "EUREKA_CLIENT_USERNAME",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "EUREKA_CLIENT_USERNAME"
                      }
                    }
                  },
                  {
                    "name": "EUREKA_CLIENT_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "platform-secrets",
                        "key": "EUREKA_CLIENT_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "EUREKA_CLIENT_SERVICE_URL_DEFAULT_ZONE",
                    "value": "http://$(EUREKA_CLIENT_USERNAME):$(EUREKA_CLIENT_PASSWORD)@eureka-discovery-service:9111/eureka/"
                  },
                  {
                    "name": "EUREKA_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "EUREKA_INSTANCE_PREFER_IP_ADDRESS",
                    "value": "true"
                  },
                  {
                    "name": "SPRING_DATASOURCE_URL",
                    "value": "jdbc:postgresql://postgres:5432/reviewsdb"
                  },
                  {
                    "name": "SPRING_DATASOURCE_USERNAME",
                    "value": "theuser"
                  },
                  {
                    "name": "SPRING_DATASOURCE_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "platform-secrets",
                        "key": "DB_RUNTIME_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "SPRING_FLYWAY_USER",
                    "value": "reviewsadmin"
                  },
                  {
                    "name": "SPRING_FLYWAY_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "platform-secrets",
                        "key": "REVIEWS_FLYWAY_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "SPRING_JPA_HIBERNATE_DDL_AUTO",
                    "value": "validate"
                  },
                  {
                    "name": "CONFIG_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "SPRING_CLOUD_CONFIG_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "CONFIG_SERVER_URL",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "CONFIG_SERVER_URL"
                      }
                    }
                  },
                  {
                    "name": "SPRING_CLOUD_CONFIG_USERNAME",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "CONFIG_CLIENT_USERNAME"
                      }
                    }
                  },
                  {
                    "name": "SPRING_CLOUD_CONFIG_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "platform-secrets",
                        "key": "CONFIG_CLIENT_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "VAULT_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "VAULT_HOST",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "VAULT_HOST"
                      }
                    }
                  },
                  {
                    "name": "VAULT_PORT",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "VAULT_PORT"
                      }
                    }
                  },
                  {
                    "name": "VAULT_URI",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "VAULT_URI"
                      }
                    }
                  },
                  {
                    "name": "VAULT_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "platform-secrets",
                        "key": "VAULT_TOKEN"
                      }
                    }
                  },
                  {
                    "name": "KEYCLOAK_ISSUER_URI",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "KEYCLOAK_ISSUER_URI"
                      }
                    }
                  },
                  {
                    "name": "KEYCLOAK_API_AUDIENCE",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "KEYCLOAK_API_AUDIENCE"
                      }
                    }
                  },
                  {
                    "name": "SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI"
                      }
                    }
                  },
                  {
                    "name": "BOOKS_SERVICE_URL",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "BOOKS_SERVICE_URL"
                      }
                    }
                  },
                  {
                    "name": "VIDEO_SERVICE_URL",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "platform-settings",
                        "key": "VIDEO_SERVICE_URL"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "768Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 9171
                  },
                  "timeoutSeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 30
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 9171
                  },
                  "timeoutSeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 6
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/readiness",
                    "port": 9171
                  },
                  "timeoutSeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 6
                }
              }
            ]
          }
        }
      }
    }
  ]
}
