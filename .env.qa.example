# Non-secret settings for running the stack locally with the qa configuration.
# `make up ENV=qa` copies this file to .env (git-ignored) and appends generated secrets.
# The infrastructure is still the local one (dev-mode Vault, Mailpit); a real qa environment
# points the same variables at its own Keycloak, Vault, Postgres and Git remote.

COMPOSE_PROJECT_NAME=identity-platform

# Selects the Spring profile of every service, and so its configuration files.
ENVIRONMENT=qa

# Image versions (docs/adr/0001-version-baseline.md)
POSTGRES_VERSION=18
KEYCLOAK_VERSION=26.8.0
VAULT_VERSION=2.1.1
MAILPIT_VERSION=v1.31

# Host ports
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
VAULT_PORT=8200
MAILPIT_UI_PORT=8025
EUREKA_PORT=9111
USER_SERVICE_PORT=9121
AUTH_SERVICE_PORT=9141
GATEWAY_PORT=9211
CONFIG_SERVER_PORT=9311

# The issuer every token carries, whether it was requested from the host or from inside the network.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=platform

# DEV ONLY: root token of the in-memory Vault dev server, used only by the bootstrap container.
# Services never receive it; they get their own policy-scoped tokens.
VAULT_DEV_ROOT_TOKEN=dev-only-root-token

# Frontends allowed to call the gateway.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# In qa the config server normally reads service-configs from its Git remote. Locally there is
# none, so it reads the mounted checkout as a directory, exactly as in dev.
CONFIG_REPO_TYPE=native
