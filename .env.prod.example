# Non-secret settings for running the stack locally with the prod configuration.
# `make up ENV=prod` copies this file to .env (git-ignored) and appends generated secrets.
# The infrastructure is still the local one (dev-mode Vault, Mailpit); a real prod environment
# points the same variables at its own Keycloak, Vault, Postgres and Git remote.

COMPOSE_PROJECT_NAME=identity-platform

# Selects the Spring profile of every service, and so its configuration files.
ENVIRONMENT=prod

# Image versions (docs/adr/0001-version-baseline.md)
POSTGRES_VERSION=18
KEYCLOAK_VERSION=26.8.0
VAULT_VERSION=2.1.1
MAILPIT_VERSION=v1.31

# Host ports
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
VAULT_PORT=8200
MAILPIT_UI_PORT=8025
EUREKA_PORT=9111
USER_SERVICE_PORT=9121
AUTH_SERVICE_PORT=9141
BOOKS_SERVICE_PORT=9151
VIDEO_SERVICE_PORT=9161
GATEWAY_PORT=9211
CONFIG_SERVER_PORT=9311

# The issuer every token carries, whether it was requested from the host or from inside the network.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=platform

# DEV ONLY: root token of the in-memory Vault dev server, used only by the bootstrap container.
# Services never receive it; they get their own policy-scoped tokens.
VAULT_DEV_ROOT_TOKEN=dev-only-root-token

# Database accounts. The names are not secret; every password lives in Vault and is read from
# there by whatever needs it. booksdb and videodb each have an admin that owns the schema and runs
# migrations, and share one runtime account that can only read and write rows.
BOOKS_DB_ADMIN_USERNAME=booksadmin
VIDEO_DB_ADMIN_USERNAME=videoadmin
APP_DB_USERNAME=theuser
# Their passwords are generated into .env, like every other secret of this environment.

# Frontends allowed to call the gateway.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# In prod the config server normally reads service-configs from its Git remote. Locally there is
# none, so it reads the mounted checkout as a directory, exactly as in dev.
CONFIG_REPO_TYPE=native
