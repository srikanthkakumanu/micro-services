# Non-secret settings for the local Docker Compose stack, development.
# `make up` copies this file to .env (git-ignored) and appends generated secrets.

COMPOSE_PROJECT_NAME=identity-platform

# Selects the Spring profile of every service, and so its configuration files.
ENVIRONMENT=dev

# Image versions (docs/adr/0001-version-baseline.md)
POSTGRES_VERSION=18
KEYCLOAK_VERSION=26.8.0
VAULT_VERSION=2.1.1
MAILPIT_VERSION=v1.31

# Host ports
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
VAULT_PORT=8200
MAILPIT_UI_PORT=8025
EUREKA_PORT=9111
USER_SERVICE_PORT=9121
AUTH_SERVICE_PORT=9141
BOOKS_SERVICE_PORT=9151
GATEWAY_PORT=9211
CONFIG_SERVER_PORT=9311

# The issuer every token carries, whether it was requested from the host or from inside the network.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=platform

# DEV ONLY: root token of the in-memory Vault dev server. Only the job that seeds Vault uses it;
# services and the other jobs get their own policy-scoped tokens.
VAULT_DEV_ROOT_TOKEN=srikanth

# Database accounts. The names are not secret; every password lives in Vault and is read from
# there by whatever needs it. booksdb and videodb each have an admin that owns the schema and runs
# migrations, and share one runtime account that can only read and write rows.
BOOKS_DB_ADMIN_USERNAME=booksadmin
VIDEO_DB_ADMIN_USERNAME=videoadmin
APP_DB_USERNAME=theuser

# DEV ONLY: fixed passwords for the accounts above, chosen by the owner so they are easy to
# remember on a development machine (docs/adr/0015-books-service-integration.md). The job that
# seeds Vault is the only thing that reads them; everything else gets them from Vault.
# Never reuse these outside a local development environment.
BOOKS_DB_ADMIN_PASSWORD=booksadmin
VIDEO_DB_ADMIN_PASSWORD=videoadmin
APP_DB_PASSWORD=theuser

# Frontends allowed to call the gateway.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
